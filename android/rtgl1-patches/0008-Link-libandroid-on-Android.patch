 CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 96537cc..2dc10a2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -195,7 +195,7 @@ if (RG_WITH_NVIDIA_DLSS)
             endif()
         else()
             target_link_libraries(RayTracedGL1 PRIVATE "$ENV{DLSS_SDK_PATH}/lib/Linux_x86_64/libnvsdk_ngx.a")
-            target_link_libraries(RayTracedGL1 PRIVATE ${CMAKE_DL_LIBS} ${RG_ANDROID_LIBS})
+            target_link_libraries(RayTracedGL1 PRIVATE ${CMAKE_DL_LIBS})
         endif()
     else()
         message(FATAL_ERROR 
@@ -209,7 +209,7 @@ endif()
 # (the system loader, or a driver the app passes in pfnVulkanGetInstanceProcAddr)
 target_include_directories(RayTracedGL1 PRIVATE ${Vulkan_INCLUDE_DIRS})
 target_compile_definitions(RayTracedGL1 PRIVATE VK_NO_PROTOTYPES)
-target_link_libraries(RayTracedGL1 PRIVATE ${CMAKE_DL_LIBS})
+target_link_libraries(RayTracedGL1 PRIVATE ${CMAKE_DL_LIBS} ${RG_ANDROID_LIBS})
 target_include_directories(RayTracedGL1 PUBLIC "Include")
 
