diff --git a/Source/VulkanDevice_Init.cpp b/Source/VulkanDevice_Init.cpp
index 3e443e5..ba046b9 100644
--- a/Source/VulkanDevice_Init.cpp
+++ b/Source/VulkanDevice_Init.cpp
@@ -1,3 +1,4 @@
+#include <cstddef>
 // Copyright (c) 2020-2021 Sultim Tsyrendashiev
 // 
 // Permission is hereby granted, free of charge, to any person obtaining a copy
@@ -602,6 +603,52 @@ void VulkanDevice::CreateDevice()
     physicalDeviceFeatures2.pNext = &asFeatures;
     physicalDeviceFeatures2.features = features;
 
+    // Only request features the device has (lavapipe, phone GPUs lack some, e.g. depthBounds),
+    // then check the ones the renderer can't do without.
+    {
+        VkPhysicalDeviceVulkan12Features                    s12     = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+        VkPhysicalDeviceMultiviewFeatures                   sMv     = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MULTIVIEW_FEATURES };
+        VkPhysicalDevice16BitStorageFeatures                s16     = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES };
+        VkPhysicalDeviceSynchronization2FeaturesKHR         sSync2  = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES_KHR };
+        VkPhysicalDeviceRayTracingPipelineFeaturesKHR       sRt     = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RAY_TRACING_PIPELINE_FEATURES_KHR };
+        VkPhysicalDeviceAccelerationStructureFeaturesKHR    sAs     = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_FEATURES_KHR };
+
+        s12.pNext = &sMv;
+        sMv.pNext = &s16;
+        s16.pNext = &sAs;
+        sAs.pNext = &sRt;
+        sRt.pNext = &sSync2;
+
+        VkPhysicalDeviceFeatures2 supported = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+        supported.pNext = &s12;
+        vkGetPhysicalDeviceFeatures2(physDevice->Get(), &supported);
+
+        // AND each VkBool32 in [first, last] of requested with supported
+        auto maskBools = [] (void *pRequested, const void *pSupported, size_t offsetFirst, size_t offsetLast)
+        {
+            auto *r = reinterpret_cast<VkBool32 *>(static_cast<uint8_t *>(pRequested) + offsetFirst);
+            auto *sp = reinterpret_cast<const VkBool32 *>(static_cast<const uint8_t *>(pSupported) + offsetFirst);
+
+            for (size_t i = 0; i <= (offsetLast - offsetFirst) / sizeof(VkBool32); i++)
+            {
+                r[i] = r[i] && sp[i];
+            }
+        };
+
+        #define RG_MASK_FEATURES(requested, supp, Type, first, last) \
+            maskBools(&(requested), &(supp), offsetof(Type, first), offsetof(Type, last))
+
+        RG_MASK_FEATURES(physicalDeviceFeatures2.features, supported.features, VkPhysicalDeviceFeatures,             robustBufferAccess,         inheritedQueries);
+        RG_MASK_FEATURES(vulkan12Features,   s12,    VkPhysicalDeviceVulkan12Features,                   samplerMirrorClampToEdge,   subgroupBroadcastDynamicId);
+        RG_MASK_FEATURES(multiviewFeatures,  sMv,    VkPhysicalDeviceMultiviewFeatures,                  multiview,                  multiviewTessellationShader);
+        RG_MASK_FEATURES(storage16,          s16,    VkPhysicalDevice16BitStorageFeatures,               storageBuffer16BitAccess,   storageInputOutput16);
+        RG_MASK_FEATURES(sync2Features,      sSync2, VkPhysicalDeviceSynchronization2FeaturesKHR,        synchronization2,           synchronization2);
+        RG_MASK_FEATURES(rtPipelineFeatures, sRt,    VkPhysicalDeviceRayTracingPipelineFeaturesKHR,      rayTracingPipeline,         rayTraversalPrimitiveCulling);
+        RG_MASK_FEATURES(asFeatures,         sAs,    VkPhysicalDeviceAccelerationStructureFeaturesKHR,   accelerationStructure,      descriptorBindingAccelerationStructureUpdateAfterBind);
+
+        #undef RG_MASK_FEATURES
+    }
+
     std::vector<VkExtensionProperties> supportedDeviceExtensions;
     uint32_t supportedExtensionsCount;
 
