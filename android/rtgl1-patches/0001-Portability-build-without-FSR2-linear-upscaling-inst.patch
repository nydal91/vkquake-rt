diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9adbe74..470e3a5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -199,9 +199,18 @@ endif()
 target_link_libraries(RayTracedGL1 PUBLIC Vulkan)
 target_include_directories(RayTracedGL1 PUBLIC "Include")
 
-# FSR2
-target_include_directories(RayTracedGL1 PRIVATE "Source/FSR2/include" )
+# FSR2: prebuilt for Windows only; elsewhere, FSR2 requests use linear upscaling
 if (WIN32)
+    set(RG_WITH_FSR2_DEFAULT ON)
+else()
+    set(RG_WITH_FSR2_DEFAULT OFF)
+endif()
+option(RG_WITH_FSR2 "Build with AMD FSR2 (needs its static libraries)" ${RG_WITH_FSR2_DEFAULT})
+target_include_directories(RayTracedGL1 PRIVATE "Source/FSR2/include" )
+if (NOT RG_WITH_FSR2)
+    message(STATUS "AMD FSR2 disabled: its requests fall back to linear upscaling")
+    target_compile_definitions(RayTracedGL1 PRIVATE RG_NO_FSR2 FFX_GCC)
+elseif (WIN32)
     if (BUILD_TYPE STREQUAL "DEBUG")
         target_link_libraries(RayTracedGL1 PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/Source/FSR2/win32/ffx_fsr2_api_x64d.lib" )
         target_link_libraries(RayTracedGL1 PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/Source/FSR2/win32/ffx_fsr2_api_vk_x64d.lib" )
