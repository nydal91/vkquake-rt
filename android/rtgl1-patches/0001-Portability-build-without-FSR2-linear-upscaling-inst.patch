+void RTGL1::ThrowVulkanError(VkResult r, const char *file, int line)
+{
+    const char *f = std::strrchr(file, '/');
+    f = f ? f + 1 : file;
+
+    throw RgException(RG_GRAPHICS_API_ERROR,
+        "Vulkan error " + std::to_string(static_cast<int>(r)) + " at " + f + ":" + std::to_string(line));
+}
diff --git a/Source/Common.h b/Source/Common.h
index 3926fcc..090a0ef 100644
--- a/Source/Common.h
+++ b/Source/Common.h
@@ -68,10 +68,13 @@ void InitDeviceExtensionFunctions_DebugUtils(VkDevice device);
 #pragma endregion
 
 
-inline void VK_CHECKERROR(const VkResult r)
-{
-    assert(r == VK_SUCCESS);
-}
+// Vulkan errors (negative results) throw in all builds, so a driver failure
+// is reported through rgGetResultDescription / pfnPrint instead of crashing later.
+// Positive results (VK_SUBOPTIMAL_KHR, VK_INCOMPLETE, ...) are not errors.
+[[noreturn]] void ThrowVulkanError(VkResult r, const char *file, int line);
+
+#define VK_CHECKERROR(r) \
+    do { const VkResult vk_check_r_ = (r); if (vk_check_r_ < 0) { RTGL1::ThrowVulkanError(vk_check_r_, __FILE__, __LINE__); } } while (0)
 
 
 #define SET_DEBUG_NAME(device, obj, type, pName) AddDebugName((device), reinterpret_cast<uint64_t>(obj), (type), (pName))
