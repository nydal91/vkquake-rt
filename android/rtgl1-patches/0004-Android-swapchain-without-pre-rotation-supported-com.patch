+
+    // The window's surface was replaced (Android recreates it after the app was
+    // in the background): destroy the swapchain and create it on the new surface.
+    // The caller destroys the old surface afterwards.
+    void ChangeSurface(VkSurfaceKHR newSurface);
     void BlitForPresent(VkCommandBuffer cmd, VkImage srcImage, uint32_t srcImageWidth, uint32_t srcImageHeight, VkFilter filter, VkImageLayout srcImageLayout = VK_IMAGE_LAYOUT_GENERAL);
     void Present(const std::shared_ptr<Queues> &queues, VkSemaphore renderFinishedSemaphore);
 
@@ -97,6 +102,9 @@ private:
     VkExtent2D surfaceExtent;
     bool isVsync;
 
+    // the last present reported the swapchain as out of date / lost
+    bool isOutdated = false;
+
     VkSwapchainKHR swapchain;
     std::vector<VkImage> swapchainImages;
     std::vector<VkImageView> swapchainViews;
