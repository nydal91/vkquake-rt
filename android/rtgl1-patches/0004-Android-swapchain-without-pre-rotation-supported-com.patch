+#ifdef RG_USE_SURFACE_ANDROID
+void VulkanDevice::SetAndroidWindow(struct ANativeWindow *window)
+{
+    if (window == nullptr)
+    {
+        throw RgException(RG_WRONG_ARGUMENT, "Android window is null");
+    }
+
+    VkAndroidSurfaceCreateInfoKHR androidInfo = {};
+    androidInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+    androidInfo.window = window;
+
+    VkSurfaceKHR newSurface = VK_NULL_HANDLE;
+    VkResult r = vkCreateAndroidSurfaceKHR(instance, &androidInfo, nullptr, &newSurface);
+    VK_CHECKERROR(r);
+
+    VkBool32 isSupported = VK_FALSE;
+    r = vkGetPhysicalDeviceSurfaceSupportKHR(physDevice->Get(), queues->GetIndexGraphics(), newSurface, &isSupported);
+    VK_CHECKERROR(r);
+    if (!isSupported)
+    {
+        vkDestroySurfaceKHR(instance, newSurface, nullptr);
+        throw RgException(RG_GRAPHICS_API_ERROR, "New Android window can't be presented to");
+    }
+
+    swapchain->ChangeSurface(newSurface);
+
+    vkDestroySurfaceKHR(instance, surface, nullptr);
+    surface = newSurface;
+}
+#endif // RG_USE_SURFACE_ANDROID
+
 void VulkanDevice::CreateSyncPrimitives()
 {
     VkResult r;
